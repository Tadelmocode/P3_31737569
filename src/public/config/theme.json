{
  "colors": {
    "background": {
      "primary": "#0f1419",
      "secondary": "#1a1f2e",
      "tertiary": "#252d3d",
      "hover": "#2d3748"
    },
    "text": {
      "primary": "#e8eef5",
      "secondary": "#a0aec0",
      "tertiary": "#718096"
    },
    "accent": {
      "primary": "#6366f1",
      "secondary": "#8b5cf6",
      "tertiary": "#ec4899"
    },
    "status": {
      "success": "#10b981",
      "warning": "#f59e0b",
      "error": "#ef4444",
      "info": "#3b82f6"
    }
  },
  "typography": {
    "fontFamily": "'Poppins', sans-serif",
    "fontMono": "'JetBrains Mono', monospace",
    "sizes": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "2rem",
      "4xl": "2.5rem"
    }
  },
  "spacing": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "4rem"
  },
  "borderRadius": {
    "sm": "0.375rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "2xl": "1.5rem",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.3)",
    "md": "0 4px 6px rgba(0, 0, 0, 0.4)",
    "lg": "0 10px 15px rgba(0, 0, 0, 0.5)",
    "xl": "0 20px 25px rgba(0, 0, 0, 0.6)"
  },
  "transitions": {
    "fast": "150ms ease-in-out",
    "base": "250ms ease-in-out",
    "slow": "350ms ease-in-out"
  },
  "gradients": {
    "primary": "linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%)",
    "secondary": "linear-gradient(135deg, #8b5cf6 0%, #ec4899 100%)"
  }
